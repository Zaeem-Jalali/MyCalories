{
  "expo": {
    "name": "CalorieAI",
    "slug": "calorie-ai",
    "scheme": "calorieai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zaeemjalali.calorieai",
      "adaptiveIcon": {
        "backgroundColor": "#FBEEDC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBEEDC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CalorieAI needs access to your photos to log meals from pictures.",
          "cameraPermission": "CalorieAI needs camera access to snap photos of your food."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CalorieAI needs camera access to scan barcodes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A15C00"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "533c3fd9-a778-4cf5-af2b-27dae4235d25"
      }
    },
    "owner": "zaeem-jalali",
    "updates": {
      "url": "https://u.expo.dev/533c3fd9-a778-4cf5-af2b-27dae4235d25",
      "fallbackToCacheTimeout": 0
    }
  }
}
